BIGDATA_DOCKER_DATA=D:/docker/bigdata/data

# Docker build proxy.
# Leave these empty when apt-get reports 502 via the local proxy.
# If direct network fails, set them back to http://host.docker.internal:7897.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,mysql,redis,namenode,datanode,resourcemanager,nodemanager,hive-metastore,hiveserver2,spark-master,spark-worker,python,agent-web

MYSQL_ROOT_PASSWORD=root123456
MYSQL_PORT=13306
HIVE_DB_USER=hive
HIVE_DB_PASSWORD=hive123456

REDIS_PORT=16379

SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g

# Workflow agent / AI report settings.
# Compatible with OpenAI-style /v1/chat/completions APIs.
LLM_API_KEY=
LLM_BASE_URL=https://anyrouter.top/v1
LLM_MODEL=gpt-5.5
LLM_WIRE_API=responses
LLM_TIMEOUT_SECONDS=60

# Comma-separated public job page URLs. Keep empty to analyze existing raw_jobs only.
CRAWL_TARGET_URLS=
CRAWL_KEYWORDS=大数据,数据分析,Spark,Hive
CRAWL_MAX_PAGES=2
CRAWL_DELAY_SECONDS=3

AGENT_SCHEDULE_ENABLED=false
AGENT_DAILY_TIME=09:00
